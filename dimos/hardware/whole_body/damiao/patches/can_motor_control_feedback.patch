+    #[test]
+    fn position_bytes_are_not_parameter_opcodes() {
+        let c = DamiaoCodec::new();
+        for low_byte in [0x33, 0x55] {
+            // Captured from a real OpenYAM gripper on CAN 0x18.
+            let frame =
+                CanFrame::classical(0x18, &[0x08, 0x62, low_byte, 0x7f, 0xf7, 0xff, 27, 24])
+                    .unwrap();
+            let Some(Event::State {
+                motor_id,
+                q,
+                t_mos,
+                t_rotor,
+                ..
+            }) = c.decode(&frame).unwrap()
+            else {
+                panic!("position byte {low_byte:#x} was discarded");
+            };
+            assert_eq!(motor_id, 0x18);
+            let expected_q =
+                f64::from(u16::from_be_bytes([0x62, low_byte])) * 25.0 / 65535.0 - 12.5;
+            assert!((q - expected_q).abs() < 1e-6);
+            assert_eq!((t_mos, t_rotor), (27, 24));
+        }
+    }
+
+    #[test]
+    fn parameter_write_ack_does_not_update_state() {
+        let c = DamiaoCodec::new();
+        let ack = CanFrame::classical(0x18, &[0x08, 0, 0x55, 0x0A, 4, 0, 0, 0]).unwrap();
+        assert!(c.decode(&ack).unwrap().is_none());
+    }
+
+    #[test]
+    fn short_frame_is_ignored_without_indexing_payload() {
+        let c = DamiaoCodec::new();
+        let frame = CanFrame::classical(0x18, &[0x08]).unwrap();
+        assert!(c.decode(&frame).unwrap().is_none());
+    }
