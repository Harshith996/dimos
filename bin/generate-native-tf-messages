"""Regenerate the SDK's standard TF message crate with dimos-cdrgen 0.1.2."""

from importlib.metadata import version
from pathlib import Path
import shutil
from tempfile import TemporaryDirectory

from dimos_cdrgen.generate import generate

root = Path(__file__).resolve().parents[1]
crate = root / "native/rust/dimos-tf-messages"
if version("dimos-cdrgen") != "0.1.2":
    raise RuntimeError("Install dimos-cdrgen==0.1.2 before regenerating TF messages")
with TemporaryDirectory() as temporary:
    output = Path(temporary) / "generated"
    generate(
        [crate / "interfaces"],
        output,
        ["tf2_msgs/msg/TFMessage"],
        module="dimos_tf",
        version="0.1.0",
        languages=("rust",),
    )
    shutil.copytree(output / "rust", crate, dirs_exist_ok=True)
